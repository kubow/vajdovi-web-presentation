{
  "name": "vajdovi-web",
  "version": "0.0.1",
  "description": "deployed on vajdovi.cz",
  "main": "index.js",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync --config vite.config.js && vite build",
    "build:docs": "cross-env OUTPUT_DIR=docs BASE_PATH=/vajdovi-web-presentation vite build && touch docs/.nojekyll",
    "build:normal": "cross-env OUTPUT_DIR=build BASE_PATH= vite build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubow/vajdovi-web-presentation.git"
  },
  "keywords": [
    "family",
    "portfolio"
  ],
  "author": "Kube Kubow",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kubow/vajdovi-web-presentation/issues"
  },
  "homepage": "https://github.com/kubow/vajdovi-web-presentation#readme",
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "cross-env": "^10.1.0",
    "mdsvex": "^0.12.8",
    "remark-gfm": "^4.0.1",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
